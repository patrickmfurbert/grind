[Unit]
Description=GRIND FastAPI backend
After=network.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__DEPLOY_ROOT__
EnvironmentFile=__DEPLOY_ROOT__/.env
ExecStart=__DEPLOY_ROOT__/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8001
Restart=on-failure

[Install]
WantedBy=multi-user.target
